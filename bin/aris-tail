#!/usr/bin/env bash
# aris-tail：第一阶段明确拒绝解析 Codex 全局会话历史。
set -euo pipefail

WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/arisc}"
TMUX_PREFIX="aris-codex"
SLUG_RE='^[a-z0-9]+(-[a-z0-9]+)*$'

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
用法：arisc tail <slug> [N]

状态：
  ARIS-Codex 当前暂不支持按项目解析 Codex 会话历史。

原因：
  Codex 会话历史存储在 ~/.codex/sessions/，不能沿用 Claude 的
  ~/.claude/projects/<encoded>/*.jsonl 路径规则。第一阶段先明确报错，
  避免误读其他会话格式或读错 Codex 会话。

替代：
  arisc goal --peek <slug> [N]
  arisc enter <slug>
  arisc report --with-pane
EOF
  exit "$code"
}

canonical_dir() {
  (cd "$1" 2>/dev/null && pwd -P) || return 1
}

pane_target() {
  printf '=%s:0.0\n' "$1"
}

ensure_session_matches_project() {
  local session="$1" project_dir="$2" session_cwd expected actual
  session_cwd="$(tmux display-message -p -t "$(pane_target "$session")" '#{pane_current_path}' 2>/dev/null || true)"
  if [[ -z "$session_cwd" ]]; then
    echo "[ERROR] 无法读取 tmux pane 当前目录，拒绝读取：$session" >&2
    exit 1
  fi
  if ! expected="$(canonical_dir "$project_dir")"; then
    echo "[ERROR] 无法解析当前项目目录，拒绝读取：$project_dir" >&2
    exit 1
  fi
  if ! actual="$(canonical_dir "$session_cwd")"; then
    echo "[ERROR] 无法解析 tmux pane 当前目录，拒绝读取：$session_cwd" >&2
    exit 1
  fi
  if [[ "$actual" != "$expected" ]]; then
    echo "[ERROR] 同名 tmux 会话不属于当前项目，拒绝读取：$session" >&2
    echo "        当前项目：$expected" >&2
    echo "        会话目录：$actual" >&2
    exit 1
  fi
}

if [[ $# -lt 1 ]]; then
  usage 2
fi
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage 0
fi

SLUG="$1"
N="${2:-20}"
[[ $# -le 2 ]] || usage 2

if ! [[ "$SLUG" =~ $SLUG_RE ]]; then
  echo "[ERROR] slug 必须是 kebab-case：$SLUG" >&2
  exit 1
fi
if ! [[ "$N" =~ ^[0-9]+$ && "$N" -gt 0 ]]; then
  echo "[ERROR] N 必须是正整数：$N" >&2
  exit 2
fi

PROJECT_DIR="$WORKSPACE_ROOT/projects/$SLUG"
SESSION="$TMUX_PREFIX-$SLUG"

[[ -d "$PROJECT_DIR" ]] || { echo "[ERROR] 项目不存在：$PROJECT_DIR" >&2; exit 1; }

echo "[ERROR] ARIS-Codex 当前暂不支持 arisc tail。"
echo "[INFO] Codex 会话历史需要单独实现 ~/.codex/sessions 解析，第一阶段先避免误读。"
echo ""

if command -v tmux >/dev/null && tmux has-session -t "=$SESSION" 2>/dev/null; then
  ensure_session_matches_project "$SESSION" "$PROJECT_DIR"
  echo "可用替代："
  echo "  arisc enter $SLUG"
  echo "  arisc goal --peek $SLUG $N"
  echo ""
  echo "当前 tmux pane 末尾 $N 行："
  tmux capture-pane -t "$(pane_target "$SESSION")" -p -S -2000 | tail -n "$N" | sed 's/^/  /'
else
  echo "目标会话未运行。可启动："
  echo "  arisc enter $SLUG"
fi

exit 2
