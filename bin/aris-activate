#!/usr/bin/env bash
# aris-activate：输出激活项目环境的 shell 片段。
set -euo pipefail

WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/arisc}"
SLUG_RE='^[a-z0-9]+(-[a-z0-9]+)*$'

LOAD_ENV=true
USE_VENV=true
DO_CD=true

usage() {
  local code="${1:-2}"
  cat >&2 <<'EOF'
用法：
  eval "$(arisc activate <slug>)"
  arisc activate [--no-env] [--no-venv] [--no-cd] <slug>

作用：
  输出一段可 eval 的 shell 代码，用于进入项目目录、加载项目 .env，
  并把项目 .venv/bin 放到 PATH 最前面。命令本身只打印 shell 片段，
  不启动 Codex、不 attach tmux、不修改文件。

选项：
  --no-env   不加载项目 .env
  --no-venv  不设置 VIRTUAL_ENV 和 .venv/bin
  --no-cd    不切换到项目目录

示例：
  eval "$(arisc activate lora)"
  eval "$(arisc activate --no-env lora)"
EOF
  exit "$code"
}

shell_quote() {
  printf '%q' "$1"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-env) LOAD_ENV=false; shift ;;
    --no-venv) USE_VENV=false; shift ;;
    --no-cd) DO_CD=false; shift ;;
    --help|-h) usage 0 ;;
    --*) echo "[ERROR] 未知参数：$1" >&2; usage 2 ;;
    *) break ;;
  esac
done

[[ $# -eq 1 ]] || usage 2
SLUG="$1"

if ! [[ "$SLUG" =~ $SLUG_RE ]]; then
  echo "[ERROR] slug 必须是 kebab-case：$SLUG" >&2
  exit 1
fi
if [[ "$SLUG" == "base" ]]; then
  echo "[ERROR] activate 只用于普通项目；base 是协调环境，请使用：arisc enter base" >&2
  exit 1
fi

PROJECT_DIR="$WORKSPACE_ROOT/projects/$SLUG"
ENV_FILE="$PROJECT_DIR/.env"
VENV_DIR="$PROJECT_DIR/.venv"

[[ -d "$PROJECT_DIR" ]] || { echo "[ERROR] 项目不存在：$PROJECT_DIR" >&2; exit 1; }

if $LOAD_ENV && [[ ! -e "$ENV_FILE" ]]; then
  echo "[ERROR] 项目 .env 缺失或符号链接悬空：$ENV_FILE" >&2
  echo "        可运行：arisc repair $SLUG" >&2
  exit 1
fi

if $USE_VENV && [[ ! -d "$VENV_DIR/bin" ]]; then
  echo "[ERROR] 项目 .venv/bin 缺失：$VENV_DIR/bin" >&2
  echo "        可运行：arisc repair $SLUG" >&2
  exit 1
fi

cat <<EOF
export ARIS_ENV_NAME=$(shell_quote "$SLUG")
export ARIS_WORKSPACE_ROOT=$(shell_quote "$WORKSPACE_ROOT")
export ARIS_PROJECT_DIR=$(shell_quote "$PROJECT_DIR")
EOF

if $DO_CD; then
  printf 'cd %s\n' "$(shell_quote "$PROJECT_DIR")"
fi

if $LOAD_ENV; then
  cat <<EOF
set -a
. $(shell_quote "$ENV_FILE")
set +a
EOF
fi

if $USE_VENV; then
  cat <<EOF
export VIRTUAL_ENV=$(shell_quote "$VENV_DIR")
export PATH=$(shell_quote "$VENV_DIR/bin"):\$PATH
EOF
fi

cat <<'EOF'
echo "[OK] 已激活 ARISC 项目环境：$ARIS_ENV_NAME" >&2
EOF
