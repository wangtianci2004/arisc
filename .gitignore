# ── local state — never tracked ──────────────────────────────────────────
# Per-device research projects (incl. base's materialized .codex/).
/projects/
# Secrets & device-specific config: API keys, ssh/llm creds, mcp paths.
/shared/
# Device-specific: absolute ARIS_REPO path written by `arisc repo`.
/config
# Soft-deleted projects.
/.trash/
# Saved handoff reports generated by `arisc report --save`.
/reports/
/vendor/

# Local execution notes used by maintainers and coding agents.
/task_plan.md
/findings.md
/progress.md

# ── shell rc backups install.sh leaves behind (if run from here) ──────────
*.aris-backup-*

# ── misc ──────────────────────────────────────────────────────────────────
*.log
__pycache__/
*.pyc
.venv/
.DS_Store
.idea/
.vscode/

# ── tracked (the tool itself): bin/ templates/ install.sh .gitignore ──────
